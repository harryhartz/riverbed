# --- Database (Turso) ---
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# --- LLM provider ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=text-embedding-004

# --- Cloudinary (free tier: https://cloudinary.com) ---
# Cloud name is on your Cloudinary dashboard home page.
CLOUDINARY_CLOUD_NAME=your-cloud-name
# Create an UNSIGNED upload preset: dashboard → Settings → Upload →
# Upload presets → Add upload preset → Signing mode: Unsigned.
CLOUDINARY_UPLOAD_PRESET=your-preset-name
# Only needed if you want deletion of images from Cloudinary itself
# (dashboard → Settings → Access Keys):
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
