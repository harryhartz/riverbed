# --- Database ---
# Local file for dev:
TURSO_DATABASE_URL=file:./riverbed.db
# Or a hosted Turso DB (https://turso.tech, free tier):
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-token

# --- LLM provider ---
# Which provider to use: gemini | anthropic | ollama
LLM_PROVIDER=gemini

# Gemini (https://aistudio.google.com — free tier, no card required)
GEMINI_API_KEY=your-gemini-key
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# Anthropic (optional, paid — for occasional high-quality passes)
# ANTHROPIC_API_KEY=
# ANTHROPIC_CHAT_MODEL=claude-sonnet-4-6

# Ollama (optional, fully local/offline)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=llama3.1
# OLLAMA_EMBED_MODEL=nomic-embed-text

PORT=3001
